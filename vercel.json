{
  "buildCommand": "python3 build.py",
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "febu-ledger\\.vercel\\.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://febu-assembly.vercel.app/"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "febu-ledger\\.vercel\\.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://febu-assembly.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://tytebptpuiiemuxlaeab.supabase.co wss://tytebptpuiiemuxlaeab.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/(?:(?:febu-assembly|how|people|process|weekly|write|ledger|tests)\\.html|(?:ledger|how|tests|fact-6-steps)\\.txt|assembly\\.ics|ledger\\.json|start(?:\\.html)?|(?:archive|checks|timestamps)/.+|assets/(?:findings\\.css|ledger\\.css|claims\\.js|how-it-works\\.svg|how-it-connects\\.svg|card\\.png))",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/timestamps/.+\\.ots",
      "headers": {
        "Content-Type": "application/octet-stream"
      },
      "continue": true
    },
    {
      "src": "/start(\\.html)?",
      "status": 308,
      "headers": {
        "Location": "/febu-assembly.html#check"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/archive",
      "schedule": "41 4 * * *"
    },
    {
      "path": "/api/keepalive",
      "schedule": "17 6 * * *"
    }
  ],
  "outputDirectory": "."
}
