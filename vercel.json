{
  "buildCommand": "python3 build.py",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/start(\\.html)?",
      "status": 308,
      "headers": {
        "Location": "/febu-assembly.html#check"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/z/?",
      "dest": "/findings.html"
    },
    {
      "src": "/",
      "dest": "/febu-assembly.html"
    }
  ],
  "crons": [
    {
      "path": "/api/archive",
      "schedule": "41 4 * * *"
    }
  ],
  "outputDirectory": "."
}
